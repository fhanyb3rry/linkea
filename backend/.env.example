MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=linkea

# IA (opcional). La key se crea en https://console.anthropic.com -> API Keys. NUNCA la subas a git.
ANTHROPIC_API_KEY=
# Modelo a usar. Opciones: claude-opus-5-5 (el más capaz), claude-sonnet-5-5 (más barato), claude-haiku-5-5 (el más barato)
ANTHROPIC_MODEL=claude-opus-5-5
